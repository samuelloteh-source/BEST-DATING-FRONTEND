{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/backend.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/app(?:/.*)?$",
      "dest": "/client/index.html"
    },
    {
      "src": "^/(api|uploads|signup|login|logout|verify/face|verify-email|resend-verification|me|notifications|discover|matches|likes|messages|profile|seed-users|health|lookaway-927883-xk9)(/.*)?$",
      "dest": "/server/backend.js"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/client/assets/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/client/index.html"
    }
  ]
}
